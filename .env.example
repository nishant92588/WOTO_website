# Server Port
PORT=3000

# Admin Portal Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Secret for JWT session tokens (keep this private!)
JWT_SECRET=your_super_secret_jwt_key_here

# MongoDB Atlas Connection URI (Get free cluster at https://cloud.mongodb.com)
# Example: mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/woto_safety?retryWrites=true&w=majority
MONGODB_URI=

# Optional: Cloudinary for Cloud Resume Storage (Get free credentials at https://cloudinary.com)
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_api_key
# CLOUDINARY_API_SECRET=your_api_secret
